{
  "name": "plugin-gtm",
  "version": "0.2.0",
  "description": "Go-to-market engine for Claude Code — analyze products, build GTM plans, generate launch content, and orchestrate market entry.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
